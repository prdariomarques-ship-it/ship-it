# ──────────────────────────────────────────────────────────────
# WhatsApp Executive Summary → n8n  |  config.example.env v2
# Copy to .env and fill in your values. Never commit .env.
# ──────────────────────────────────────────────────────────────

# ── n8n Webhook (outgoing — script POSTs results here) ────────
N8N_WEBHOOK_URL=https://your-n8n.example.com/webhook/whatsapp-executive-summary
# Shared secret: n8n checks Header "x-api-key" matches this value.
# Also used to protect /api/flush and /api/status on receiver.py.
N8N_API_KEY=change-me-super-secret-token

# ── LLM Provider ──────────────────────────────────────────────
LLM_PROVIDER=anthropic   # "anthropic" (default) | "gemini"
LLM_MODEL=               # leave blank to use provider default
                         # Anthropic: claude-sonnet-5
                         # Gemini   : gemini-2.0-flash

ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# ── receiver.py (FastAPI ingest server) ───────────────────────
RECEIVER_HOST=0.0.0.0
RECEIVER_PORT=8001

# Full URL that n8n uses to reach receiver.py (set in n8n env vars too)
# Example: http://host.docker.internal:8001  (n8n in Docker → receiver on host)
#          http://receiver:8001               (both in same Docker network)
RECEIVER_BASE_URL=http://localhost:8001

# ── Evolution API ─────────────────────────────────────────────
# Secret token configured in Evolution API → Webhook → Token field.
# When set, every POST to /webhook/evolution must carry it as
# X-Api-Key header OR as "apikey" field in the JSON body.
EVOLUTION_WEBHOOK_TOKEN=change-me-evo-secret

# ── SQLite Buffer ─────────────────────────────────────────────
# Absolute or relative path to the buffer database file.
BUFFER_DB_PATH=./whatsapp_buffer.db

# How many hours back to look when flushing (schedule runs at 12h and 18h,
# so 8h ensures no message falls through even if a schedule fires late).
BUFFER_WINDOW_HOURS=8

# ── n8n Environment Variables (set in n8n UI → Settings → Variables) ─
# These mirror the values above so n8n nodes can reference them via $env.*
#
# RECEIVER_BASE_URL = http://localhost:8001
# N8N_API_KEY       = (same as above)
# TELEGRAM_CHAT_ID  = -1001234567890   (your channel/group ID)
# GOOGLE_SHEET_ID   = 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# ──────────────────────────────────────────────────────────────
# WhatsApp Executive Summary → n8n
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────

# n8n Webhook endpoint (from the Webhook node → "Webhook URL" field)
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/YOUR-WEBHOOK-ID

# Shared secret configured in n8n's "Header Auth" credential
# n8n checks: Header name = "x-api-key", Value = this token
N8N_API_KEY=change-me-super-secret-token

# ── LLM Provider ──────────────────────────────────────────────
# Options: "anthropic" (default) | "gemini"
LLM_PROVIDER=anthropic

# Model override — leave blank to use the default per provider
# Anthropic default : claude-sonnet-5
# Gemini default    : gemini-2.0-flash
LLM_MODEL=

# API keys — only the key for the chosen provider is required
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

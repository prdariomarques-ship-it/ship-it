+async def _insert_receipt_do_nothing(db: AsyncSession, values: dict) -> int | None:
+    """INSERT ... ON CONFLICT DO NOTHING RETURNING id, sem SAVEPOINT. Devolve None se a chave ja existe.
+
+    No PostgreSQL, uma insercao concorrente ainda nao confirmada faz este INSERT ESPERAR a outra transacao terminar: se ela
+    confirmou, o conflito e reconhecido (None); se ela desfez, o INSERT procede. O recibo fica na MESMA transacao do pedido,
+    entao um rollback o desfaz junto com contato, cliente e orcamento criados depois."""
+    dialect = db.get_bind().dialect.name
+    if dialect == "postgresql":
+        insert = pg_dialect.insert
+    elif dialect == "sqlite":
+        insert = sqlite_dialect.insert
+    else:  # outros bancos: caminho antigo, com SAVEPOINT
+        receipt = IntegrationIdempotency(**values)
+        try:
+            async with db.begin_nested():
+                db.add(receipt)
+                await db.flush()
+            return receipt.id
+        except IntegrityError:
+            return None
+    statement = (
+        insert(IntegrationIdempotency)
+        .values(**values)
+        .on_conflict_do_nothing(index_elements=["integration", "operation", "idempotency_key"])
+        .returning(IntegrationIdempotency.id)
+    )
+    return await db.scalar(statement)
+

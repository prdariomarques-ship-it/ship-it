@@ -0,0 +1,177 @@
+"""Opt-in: cadeia COMPLETA de migrations em PostgreSQL (alembic upgrade head) e preservacao de dados no upgrade/downgrade.
+
+Executar explicitamente:
+    FLOWCORE_TEST_DATABASE_URL=postgresql+asyncpg://...@127.0.0.1/flowcore_test pytest -q tests/flowcore_postgres_migration_harness.py
+
+Cria UM banco novo `flowcore_test_mig_<hex>` no servidor local indicado e o remove ao final. Mesmas travas do outro harness:
+so loopback, so postgresql+asyncpg, banco-base `flowcore_test` ou `flowcore_test_*`. Nenhuma migration antiga e alterada."""
+
+import asyncio
+import os
+import uuid
+from datetime import datetime, timedelta, timezone
+from decimal import Decimal
+from pathlib import Path
+
+import pytest
+import pytest_asyncio
+from alembic import command
+from alembic.config import Config
+from alembic.script import ScriptDirectory
+from sqlalchemy import insert, inspect, select, text
+from sqlalchemy.engine import make_url
+from sqlalchemy.ext.asyncio import create_async_engine
+
+from models.contact import Contact
+from models.integration_idempotency import IntegrationIdempotency
+from models.store import StoreCustomer, StoreQuote
+
+BACKEND = Path(__file__).parents[1]
+PRE_FLOWCORE_HEAD = "9e2f1c6d7a80"
+FLOWCORE_REVISION = "a84d20b1c6f3"
+HISTORICAL_STORE_QUOTE_COLUMNS = {
+    "id", "contact_id", "customer_id", "items", "total", "expires_at", "confirmed_at", "order_result",
+    "created_at", "updated_at",
+}
+
+
+def _safe_url():
+    raw = os.environ.get("FLOWCORE_TEST_DATABASE_URL")
+    if not raw:
+        pytest.fail("Defina FLOWCORE_TEST_DATABASE_URL (PostgreSQL local, banco flowcore_test*).", pytrace=False)
+    url = make_url(raw)
+    if url.drivername != "postgresql+asyncpg":
+        pytest.fail("FLOWCORE_TEST_DATABASE_URL deve usar postgresql+asyncpg.", pytrace=False)
+    if (url.host or "").lower() not in {"localhost", "127.0.0.1", "::1"}:
+        pytest.fail("Somente servidor em loopback.", pytrace=False)
+    name = url.database or ""
+    if not (name == "flowcore_test" or name.startswith("flowcore_test_")):
+        pytest.fail("O banco deve ser flowcore_test ou comecar com flowcore_test_.", pytrace=False)
+    return url
+
+
+@pytest_asyncio.fixture
+async def migration_db():
+    base_url = _safe_url()
+    name = "flowcore_test_mig_" + uuid.uuid4().hex[:12]
+    admin = create_async_engine(base_url, isolation_level="AUTOCOMMIT")
+    async with admin.connect() as conn:
+        await conn.execute(text(f'CREATE DATABASE "{name}"'))
+    url = base_url.set(database=name)
+    engine = create_async_engine(url)
+    try:
+        yield url.render_as_string(hide_password=False), engine
+    finally:
+        await engine.dispose()
+        async with admin.connect() as conn:
+            await conn.execute(text(f'DROP DATABASE IF EXISTS "{name}" WITH (FORCE)'))
+        await admin.dispose()
+
+
+def _config(url: str) -> Config:
+    cfg = Config(str(BACKEND / "alembic.ini"))
+    cfg.set_main_option("script_location", str(BACKEND / "alembic"))
+    cfg.set_main_option("sqlalchemy.url", url)
+    return cfg
+
+
+async def _upgrade(url, revision):
+    await asyncio.to_thread(command.upgrade, _config(url), revision)
+
+
+async def _downgrade(url, revision):
+    await asyncio.to_thread(command.downgrade, _config(url), revision)
+
+
+async def _current(engine) -> str | None:
+    async with engine.connect() as conn:
+        return await conn.scalar(text("select version_num from alembic_version"))
+
+
+async def _columns(engine, table):
+    async with engine.connect() as conn:
+        return await conn.run_sync(lambda c: {col["name"] for col in inspect(c).get_columns(table)})
+
+
+async def _tables(engine):
+    async with engine.connect() as conn:
+        return await conn.run_sync(lambda c: set(inspect(c).get_table_names()))
+
+
+async def _indexes(engine, table):
+    async with engine.connect() as conn:
+        return await conn.run_sync(lambda c: {i["name"] for i in inspect(c).get_indexes(table)})
+
+
+def test_the_chain_has_a_single_head_and_the_flowcore_migration_hangs_from_the_previous_head():
+    script = ScriptDirectory(str(BACKEND / "alembic"))
+    assert script.get_heads() == [FLOWCORE_REVISION]
+    assert script.get_revision(FLOWCORE_REVISION).down_revision == PRE_FLOWCORE_HEAD
+
+
+@pytest.mark.asyncio
+async def test_full_chain_upgrade_head_preserves_existing_rows_and_downgrade_keeps_them(migration_db):
+    url, engine = migration_db
+
+    # 1) cadeia completa ATE a cabeca anterior ao FlowCore, a partir de um banco vazio
+    await _upgrade(url, PRE_FLOWCORE_HEAD)
+    assert await _current(engine) == PRE_FLOWCORE_HEAD
+    # esquema historico escrito a mao, independente do modelo atual
+    assert await _columns(engine, "store_quotes") == HISTORICAL_STORE_QUOTE_COLUMNS
+    assert "integration_idempotency" not in await _tables(engine)
+
+    # 2) dados existentes (contato, cliente, orcamento aberto e outro confirmado), gravados SEM a coluna nova
+    now = datetime.now(timezone.utc)
+    async with engine.begin() as conn:
+        contact_id = (await conn.execute(insert(Contact.__table__).values(name="Ana", phone="5511999990100").returning(Contact.__table__.c.id))).scalar_one()
+        customer_id = (await conn.execute(insert(StoreCustomer.__table__).values(name="Ana", phone="5511999990100").returning(StoreCustomer.__table__.c.id))).scalar_one()
+        for quote_id, confirmed in (("QSEEDABERTO1", None), ("QSEEDCONFIRM", now)):
+            await conn.execute(insert(StoreQuote.__table__).values(
+                id=quote_id, contact_id=contact_id, customer_id=customer_id,
+                items=[{"sku": "S1", "quantity": 2}], total=Decimal("12.34"),
+                expires_at=now + timedelta(minutes=30), confirmed_at=confirmed,
+                order_result=None if confirmed is None else {"order": {"id": quote_id}},
+            ))
+
+    async def snapshot():
+        async with engine.connect() as conn:
+            rows = (await conn.execute(text(
+                "select id, contact_id, customer_id, items::text, total, expires_at, confirmed_at, order_result::text "
+                "from store_quotes order by id"
+            ))).all()
+        return [tuple(r) for r in rows]
+
+    before = await snapshot()
+    assert len(before) == 2
+
+    # 3) upgrade ate a cabeca (a84d20b1c6f3): linhas intactas, coluna nova NULA, tabela de recibos criada
+    await _upgrade(url, "head")
+    assert await _current(engine) == FLOWCORE_REVISION
+    assert await snapshot() == before
+    assert await _columns(engine, "store_quotes") == HISTORICAL_STORE_QUOTE_COLUMNS | {"integration_source"}
+    assert await _columns(engine, "store_quotes") == set(StoreQuote.__table__.columns.keys())
+    assert "ix_store_quotes_integration_source" in await _indexes(engine, "store_quotes")
+    assert await _columns(engine, "integration_idempotency") == set(IntegrationIdempotency.__table__.columns.keys())
+    async with engine.connect() as conn:
+        assert await conn.scalar(text("select count(*) from store_quotes where integration_source is not null")) == 0
+
+    # 4) um orcamento e um recibo do FlowCore; depois downgrade de UMA revisao
+    async with engine.begin() as conn:
+        await conn.execute(text("update store_quotes set integration_source='flowcore' where id='QSEEDABERTO1'"))
+        await conn.execute(insert(IntegrationIdempotency.__table__).values(
+            integration="flowcore", operation="create_quote", idempotency_key="k1", payload_hash="h" * 64,
+            created_at=now, updated_at=now,
+        ))
+    await _downgrade(url, PRE_FLOWCORE_HEAD)
+    assert await _current(engine) == PRE_FLOWCORE_HEAD
+    assert await snapshot() == before                      # as duas linhas permanecem, valores iguais
+    assert await _columns(engine, "store_quotes") == HISTORICAL_STORE_QUOTE_COLUMNS
+    assert "integration_idempotency" not in await _tables(engine)
+    async with engine.connect() as conn:
+        assert await conn.scalar(select(text("count(*)")).select_from(Contact.__table__)) == 1
+        assert await conn.scalar(select(text("count(*)")).select_from(StoreCustomer.__table__)) == 1
+
+    # 5) novo upgrade: idempotente, dados ainda intactos
+    await _upgrade(url, "head")
+    assert await snapshot() == before
+    assert await _current(engine) == FLOWCORE_REVISION

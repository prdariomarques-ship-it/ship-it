 from pydantic import SecretStr
 
 
+@pytest.fixture
+def strict_sqlite(db_engine):
+    """SQLite com transacao real: BEGIN explicito antes do primeiro SAVEPOINT (receita documentada do SQLAlchemy para pysqlite).
+
+    Sem isso, o modo antigo do pysqlite abre o SAVEPOINT FORA de uma transacao e o RELEASE o torna definitivo, de modo que um
+    rollback posterior NAO desfaz o recibo. PostgreSQL (o banco de producao) nao tem essa limitacao; o harness
+    `flowcore_postgres_harness.py` cobre a semantica real. A fixture afeta so o engine do teste que a pede."""
+    def disable_driver_begin(dbapi_connection, _connection_record):
+        dbapi_connection.isolation_level = None
+
+    def emit_begin(connection):
+        connection.exec_driver_sql("BEGIN")
+
+    event.listen(db_engine.sync_engine, "connect", disable_driver_begin)
+    event.listen(db_engine.sync_engine, "begin", emit_begin)
+    return db_engine
+
+

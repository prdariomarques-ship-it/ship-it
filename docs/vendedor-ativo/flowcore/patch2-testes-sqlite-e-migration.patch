+
+async def test_flowcore_idempotency_migration_upgrade_and_downgrade(db_engine):
+    """A migration a84d20b1c6f3 leva store_quotes ao modelo atual e cria/remove a tabela de recibos."""
+    quotes = _load("f4c18a2d9e10_store_quotes.py", "store_quote_migration_for_flowcore")
+    flowcore = _load("a84d20b1c6f3_flowcore_idempotency.py", "flowcore_idempotency_migration")
+    assert flowcore.down_revision == "9e2f1c6d7a80"
+
+    def exercise(connection):
+        # a fixture cria tudo pelo modelo; volta ao estado ANTERIOR a a84d20b1c6f3
+        IntegrationIdempotency.__table__.drop(connection)
+        StoreQuote.__table__.drop(connection)
+        with Operations.context(MigrationContext.configure(connection)):
+            quotes.upgrade()
+            assert "integration_idempotency" not in inspect(connection).get_table_names()
+            assert "integration_source" not in {c["name"] for c in inspect(connection).get_columns("store_quotes")}
+
+            flowcore.upgrade()
+            names = {c["name"] for c in inspect(connection).get_columns("store_quotes")}
+            assert names == set(StoreQuote.__table__.columns.keys())
+            assert "ix_store_quotes_integration_source" in {
+                i["name"] for i in inspect(connection).get_indexes("store_quotes")
+            }
+            assert "integration_idempotency" in inspect(connection).get_table_names()
+
+            flowcore.downgrade()
+            assert "integration_source" not in {c["name"] for c in inspect(connection).get_columns("store_quotes")}
+            assert "integration_idempotency" not in inspect(connection).get_table_names()
+            quotes.downgrade()
+        assert "store_quotes" not in inspect(connection).get_table_names()
+
+    async with db_engine.begin() as connection:
+        await connection.run_sync(exercise)

# Variáveis do BACKEND para o vendedor ativo. NENHUM valor é real. Tudo desligado por padrão.
# Tokens e URLs reais: só em variáveis de ambiente/secret store da máquina, nunca neste arquivo ou no git.

# --- voz ---------------------------------------------------------------------------------------------------------
STORE_VOICE_ENABLED=false
STORE_VOICE_URL=                       # ex.: http://voice-service:8765  (rede interna; nunca URL pública)
STORE_VOICE_TOKEN=                     # o MESMO valor configurado para o agente "loja" em VOICE_TOKENS do serviço
STORE_VOICE_AGENT_PROFILE=loja
STORE_VOICE_POLICY=mirror_audio        # mirror_audio | customer_preference  (preferência por texto SEMPRE vence)
STORE_VOICE_TIMEOUT_SECONDS=150
STORE_VOICE_MAX_SCRIPT_CHARS=300
STORE_VOICE_MAX_AUDIO_SECONDS=40
STORE_VOICE_MAX_JOB_AGE_SECONDS=600
STORE_VOICE_MAX_PER_CONTACT_PER_DAY=3
STORE_VOICE_DISCLOSURE_DAYS=7

# --- acompanhamentos (retomada de orçamento, reposição) ----------------------------------------------------------
STORE_FOLLOWUPS_ENABLED=false          # sem isto, "--apply" é recusado; a simulação funciona
STORE_TIMEZONE=America/Sao_Paulo
STORE_FOLLOWUP_WINDOW_START_HOUR=9
STORE_FOLLOWUP_WINDOW_END_HOUR=18
STORE_FOLLOWUP_DAYS=0,1,2,3,4,5        # segunda=0 ... domingo=6
STORE_FOLLOWUP_QUOTE_RESUME_DELAY_MINUTES=120
STORE_FOLLOWUP_MAX_AGE_DAYS=7
STORE_FOLLOWUP_MAX_ATTEMPTS=1
STORE_FOLLOWUP_MIN_GAP_HOURS=72
STORE_FOLLOWUP_RESTOCK_MIN_ORDERS=3
STORE_FOLLOWUP_RESTOCK_TOLERANCE=0.25
STORE_FOLLOWUP_REFUSAL_COOLDOWN_DAYS=30
STORE_FOLLOWUP_SCAN_LIMIT=50

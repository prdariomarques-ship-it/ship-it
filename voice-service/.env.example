# Variáveis do serviço de voz. NENHUM valor aqui é real: gere tokens longos e aleatórios fora do repositório.
VOICE_TOKENS=loja=TROQUE-POR-TOKEN-ALEATORIO-DE-32-OU-MAIS-CARACTERES
VOICE_ENGINE=chatterbox
VOICE_DEVICE=cpu
VOICE_MODEL_REVISION=
VOICE_MODEL_DIR=/models
VOICE_PROFILES_DIR=/var/lib/voice-service/profiles
VOICE_STORAGE_DIR=/var/lib/voice-service/tmp
VOICE_MAX_TEXT_CHARS=350
VOICE_MAX_AUDIO_SECONDS=40
VOICE_MAX_CONCURRENCY=1
VOICE_QUEUE_MAX=4
VOICE_GENERATION_TIMEOUT_SECONDS=180
VOICE_RESULT_TTL_SECONDS=900

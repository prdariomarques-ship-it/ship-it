# Copy these lines into docker/.env (the same file the rest of the stack already uses). Never commit real values.
#
# off (default) = dry-run: bulletins/alerts are only written to the outbox log inside the volume.
# on            = real Telegram delivery + command polling. Needs BOTH credentials of each enabled bot.
MB_SEND=off
# Run only some bots (comma list of ids from profiles.toml). Empty = all. Example: MB_PROFILES=national
MB_PROFILES=

# Bot 1 - Mercado Brasil (create the bot with @BotFather; the chat id is the chat that may use the bot)
MB_NATIONAL_BOT_TOKEN=
MB_NATIONAL_CHAT_ID=
# Bot 2 - Mercado Global
MB_GLOBAL_BOT_TOKEN=
MB_GLOBAL_CHAT_ID=
